# 单机多节点集群（演示 / 中小规模）配置：cp .env.example .env 后修改
COMPOSE_PROJECT_NAME=llm-gateway-cluster
GATEWAY_IMAGE=llm-gateway:latest
# 对外入口（Nginx 负载均衡）端口
LB_PORT=80
# slave 节点副本数；运行中扩缩容：docker compose up -d --scale gateway-slave=4
SLAVE_REPLICAS=2
TZ=Asia/Shanghai

# 集群内部网段：网关只信任来自该网段（即 Nginx）的 X-Forwarded-For
CLUSTER_SUBNET=172.28.0.0/16

# [必改] 所有节点共享同一套密钥
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
JWT_SECRET=change-me-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

LOG_LEVEL=info
FEISHU_WEBHOOK_URL=
# 每个节点的数据库连接池上限：节点数 × 该值 需小于 PostgreSQL max_connections
PG_MAX_OPEN_CONNS=40
