# 多主机集群：每台机器各放一份 .env（同一套密钥），按机器角色启动对应的 compose 文件
#   数据机：docker compose -f infra.compose.yml up -d     （生产建议改用云 RDS / 高可用 Redis）
#   主节点：docker compose -f master.compose.yml up -d
#   从节点：docker compose -f slave.compose.yml up -d      （每台从节点机器各一份，NODE_NAME 不同）
#   入口机：Nginx 使用 nginx.conf（把上游 IP 改成各节点地址）

GATEWAY_IMAGE=registry.example.com/llm-gateway:1.0.0
GATEWAY_PORT=8080
TZ=Asia/Shanghai

# ---- 共享存储（所有节点必须指向同一个 PostgreSQL、同一个 Redis）----
PG_HOST=10.0.0.10
PG_PORT=5432
PG_USER=llmgateway
PG_PASSWORD=change-me-postgres
PG_DBNAME=llmgateway
PG_SSLMODE=disable
# 节点数 × PG_MAX_OPEN_CONNS 需小于 PostgreSQL max_connections
PG_MAX_OPEN_CONNS=40
REDIS_ADDR=10.0.0.10:6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# ---- 集群内所有节点必须一致 ----
JWT_SECRET=change-me-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# ---- 每台机器不同 ----
# master 机器写 gw-master；从节点写 gw-slave-1 / gw-slave-2 ...
NODE_NAME=gw-slave-1
# 负载均衡（入口 Nginx / SLB）的地址或网段，逗号分隔
TRUSTED_PROXIES=10.0.0.5

LOG_LEVEL=info
FEISHU_WEBHOOK_URL=
