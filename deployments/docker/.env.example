# 单机 Docker Compose 部署配置：cp .env.example .env 后按需修改
# 带 [必改] 的在生产环境必须改成随机强密码（openssl rand -hex 32）

COMPOSE_PROJECT_NAME=llm-gateway
# 镜像：默认本地构建并打此 tag；使用私有仓库时改成 registry.example.com/llm-gateway:1.0.0
GATEWAY_IMAGE=llm-gateway:latest
# 宿主机端口（控制台 + OpenAI 兼容 API 都在这个端口）
GATEWAY_PORT=8080
TZ=Asia/Shanghai

# [必改] 数据库 / Redis 密码
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
# [必改] 控制台登录 JWT 签名密钥（集群内所有节点必须一致）
JWT_SECRET=change-me-jwt-secret
# 首个超级管理员（仅数据库里没有超管时创建，之后在控制台改密码）
ADMIN_USERNAME=admin
# [必改]
ADMIN_PASSWORD=change-me-admin

# 可选
LOG_LEVEL=info
FEISHU_WEBHOOK_URL=
# 网关前面还有 SLB / Ingress 时，填它们的网段，逗号分隔；否则留空
TRUSTED_PROXIES=
